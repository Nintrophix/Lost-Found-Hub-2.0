# Copy to backend/.env and fill in real values. Never commit .env.

# development | test | production
# production disables /api/docs and refuses COOKIE_SECURE=false, EMAIL_BACKEND=console
# and RATE_LIMIT_ENABLED=false.
ENVIRONMENT=development

# Defaults to backend/data/lostfound.db when unset.
# DATABASE_URL=sqlite:///./data/lostfound.db
SQL_ECHO=false

# Required. Comma-separated campus email domains allowed to register (exact match).
ALLOWED_EMAIL_DOMAINS=srmist.edu.in

# Comma-separated origins allowed by CORS (the Angular dev server by default).
CORS_ORIGINS=http://localhost:4200

# Base URL used in verification and password reset email links.
FRONTEND_BASE_URL=http://localhost:4200

# Sessions and cookies. Keep COOKIE_SECURE=true anywhere served over HTTPS.
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
RATE_LIMIT_ENABLED=true

# Email. "console" prints messages (including secret links) to the server log: development only.
EMAIL_BACKEND=console
EMAIL_FROM=Campus Lost & Found Hub <no-reply@srmist.edu.in>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Uploaded images are stored here, outside any public static directory.
# UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Lifetime of a handover QR token.
QR_TOKEN_TTL_MINUTES=15

# Matching. Weights are relative and renormalised over the signals available for a pair
# (a missing colour does not count against it). Suggestions are stored when the 0 to 100 score
# reaches MATCH_THRESHOLD. After changing these, run: python -m app.cli rematch
MATCH_WEIGHT_CATEGORY=30
MATCH_WEIGHT_DESCRIPTION=25
MATCH_WEIGHT_COLOR=15
MATCH_WEIGHT_LOCATION=15
MATCH_WEIGHT_DATE=15
MATCH_THRESHOLD=50
# Date points fall from full (within a day) to zero at this many days apart.
MATCH_DATE_WINDOW_DAYS=14
